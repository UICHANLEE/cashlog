## 프론트 (Vite) — 브라우저에 변수만 올림
#
# 사진 분석: mock (파일명 휴리스틱) | remote (/api/analyze 등)
VITE_PHOTO_ANALYSIS_MODE=mock
# remote일 때 분석 파이프라인: receipt | product
# - receipt: 기존 영수증/일반 이미지 분석
# - product: B안 상품 사진 탐지→분류→카테고리 추천 구조
VITE_IMAGE_ANALYSIS_PIPELINE=receipt
#
# remote일 때 호출 주소 (비우면 브라우저 origin 기준 `/api/analyze`)
# 로컬 상품 분석: `npm run dev`가 `/api/analyze-image` → FastAPI 8010으로 프록시
# 로컬 receipt 분석: `npm run dev` + `vercel dev` 함께 쓸 때 vite proxy가 `/api` → localhost:3000
# VITE_ANALYZE_API_URL=http://127.0.0.1:3000/api/analyze
# VITE_ANALYZE_IMAGE_API_URL=/api/analyze-image
# 브라우저에서 Cashlog API를 호출할 수 있는 실제 앱 주소만 쉼표로 구분
# CASHLOG_ALLOWED_ORIGINS=https://cashlog.example.com,https://cashlog.vercel.app
#
# 로컬 상품 사진 분석을 켜려면:
# VITE_PHOTO_ANALYSIS_MODE=remote
# VITE_IMAGE_ANALYSIS_PIPELINE=product
#
# Vite dev proxy target
# PRODUCT_ANALYZER_PROXY_TARGET=http://127.0.0.1:8010
# CATAI_DEV_PROXY_TARGET=http://127.0.0.1:8010 # legacy alias
# CASHLOG_API_PROXY_TARGET=http://127.0.0.1:3000
#
## Supabase Auth + DB sync (프론트 공개용 publishable key 권장)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# VITE_SUPABASE_ANON_KEY=legacy-anon-key # 기존 프로젝트 호환용
# 서버 전용. Vercel에만 넣고 VITE_ 접두사를 붙이지 않습니다.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role
# AUTH_RATE_LIMIT_SALT=32자-이상의-무작위-문자열
#
## Vercel / 서버 (Git에 넣지 말 것) — 코드에 직접 넣으면 브라우저에 노출됨
# OPENAI_API_KEY=
# 선택: 모델 (기본 gpt-4o-mini)
# OPENAI_VISION_MODEL=gpt-4o-mini
#
# 추천 모델 프리셋
# - openai-mini: OpenAI gpt-4o-mini (기본)
# - qwen25vl3b-hf: Hugging Face Router에서 Qwen/Qwen2.5-VL-3B-Instruct 사용
# - qwen25vl3b-local: 로컬 vLLM/SGLang OpenAI-compatible 서버 사용
# VISION_MODEL_PRESET=qwen25vl3b-hf
# HF_TOKEN=
#
# 커스텀 OpenAI-compatible VLM endpoint
# VISION_API_BASE_URL=https://router.huggingface.co/v1
# VISION_API_KEY=
# VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# VISION_ENGINE=qwen
#
# 로컬 FastAPI 상품 사진 분류 서버
# 1) pip로 catai 패키지를 설치한 뒤 FastAPI 서버를 8010 포트에 실행
#    python -m pip install git+https://github.com/UICHANLEE/catai.git
#    CATAI_DEVICE=mps catai-serve-cashlog --host 127.0.0.1 --port 8010
# 2) Vite dev는 /api/analyze-image를 위 서버로 프록시
# 3) Vercel/API 서버가 /api/analyze-image 요청 시 아래 서버를 먼저 호출
# PRODUCT_ANALYZER_API_URL=http://127.0.0.1:8010/analyze-image
# CATAI_PRODUCT_API_URL=http://127.0.0.1:8010/analyze-image
